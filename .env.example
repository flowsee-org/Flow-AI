# GEMINI_API_KEY: Required for Gemini AI API calls (single-key fallback).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Comma-separated list of API keys for rotation / load balancing.
# When set, the centralized AI service rotates across keys to distribute token
# consumption and avoid 429 rate-limit errors on a single account.
# Example: GEMINI_API_KEYS="key1,key2,key3"
GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI_RATE_LIMIT_MAX: Max requests per rate-limit window per client (default: 30)
AI_RATE_LIMIT_MAX="30"
# AI_RATE_LIMIT_WINDOW_MS: Rate-limit window in milliseconds (default: 60000 = 1 min)
AI_RATE_LIMIT_WINDOW_MS="60000"
# AI_CACHE_TTL_MS: Response cache TTL in milliseconds (default: 3600000 = 1 hour)
AI_CACHE_TTL_MS="3600000"
